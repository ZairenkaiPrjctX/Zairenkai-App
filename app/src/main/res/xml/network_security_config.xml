<!--
  HTTPS only, trusting the system's certificate authorities only (never user-added ones), in every
  build: the app's only network use is reading and downloading its own releases from GitHub
  (docs/build/releases.md), and the model download for the on-device assistant.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
